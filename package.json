{
  "name": "clawdhq",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --concurrency 25",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:stress": "tsx scripts/stress-test.ts",
    "seed:agents": "pnpm --filter @clawdhq/contracts-evm seed:agents",
    "clean": "turbo run clean",
    "near:build": "cargo build --manifest-path packages/contracts-near/Cargo.toml --target wasm32-unknown-unknown --release --locked && node scripts/near/copy-wasm.mjs",
    "near:test": "cargo test --manifest-path packages/contracts-near/Cargo.toml --locked",
    "near:demo": "pnpm near:build && pnpm --filter @clawdhq/near test:sandbox",
    "near:unit": "pnpm --filter @clawdhq/near test"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
