{
  "name": "@clawdhq/sportystake-sdk",
  "version": "0.1.3",
  "private": true,
  "description": "TypeScript SDK for SportyStake.com smart contracts (vendored in-tree; previously published to GitHub Packages as @uncletom29/sportystake-sdk)",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"no unit tests yet\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "viem": "2.53.1"
  },
  "peerDependencies": {
    "viem": "^2.53.1"
  }
}
