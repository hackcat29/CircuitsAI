# Public testnet deployment settings. Copy into apps/web/.env.local for the web preview.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_COMMERCE_ACCOUNT=circuitsai-hackcat.testnet
NEAR_USDC_CONTRACT=usdc.circuitsai-hackcat.testnet
NEAR_MPC_CONTRACT=v1.signer-prod.testnet

# Select per agent via the model picker, or opt the platform in globally.
# HOSTED_RUNTIME_PLATFORM_PROVIDER=NEAR_AI
# NEAR_AI_MODEL=z-ai/glm-5.3-flash
# NEAR_AI_API_KEY=

# Runtime credentials must be finite, function-call-only keys. Never place an owner key here.
# NEAR_RUNTIME_KEYS_JSON={}
# AGENT_WALLET_CUSTODY_MODE=NEAR_CHAIN_SIGNATURES
# NEAR_AGENT_ACCOUNT_BINDINGS_JSON={}

# Intents uses mainnet assets even while the NEAR commerce demo uses testnet.
# NEAR_INTENTS_JWT=
NEAR_INTENTS_ENABLE_EXECUTION=false
# NEAR_INTENTS_SERVICE_ASSET_MONAD_MAINNET=
# NEAR_INTENTS_ORIGIN_ASSET_MONAD_MAINNET=
# NEAR_INTENTS_SWAP_ASSET_MONAD_MAINNET=

# Optional official collateral mirror; verification stays enabled.
# NEAR_AI_PCCS_URL=https://cloud.near.ai/api/proxy/pccs
